/system       ext4     /dev/block/platform/msm_sdcc.1/by-name/system       flags=display=system
/cache        ext4     /dev/block/platform/msm_sdcc.1/by-name/cache        flags=display=cache
/data         ext4     /dev/block/platform/msm_sdcc.1/by-name/userdata     flags=display=data
/sdcard       vfat     /dev/block/mmcblk1p1                                flags=display=sdcard
/emmc         vfat     /dev/block/platform/msm_sdcc.1/by-name/usbmsc       flags=display=emmc
/boot         emmc     /dev/block/platform/msm_sdcc.1/by-name/boot         flags=display=boot
/recovery     emmc     /dev/block/platform/msm_sdcc.1/by-name/recovery     flags=display=recovery
/misc         emmc     /dev/block/platform/msm_sdcc.1/by-name/misc         flags=display=misc
/splash       emmc     /dev/block/platform/msm_sdcc.1/by-name/splash       flags=display=splash
/firmware     emmc     /dev/block/platform/msm_sdcc.1/by-name/modem        flags=display=firmware
/sbl1         emmc     /dev/block/platform/msm_sdcc.1/by-name/sbl1         flags=display=sbl1
/aboot        emmc     /dev/block/platform/msm_sdcc.1/by-name/aboot        flags=display=aboot
/rpm          emmc     /dev/block/platform/msm_sdcc.1/by-name/rpm          flags=display=rpm
/tz           emmc     /dev/block/platform/msm_sdcc.1/by-name/tz           flags=display=tz
